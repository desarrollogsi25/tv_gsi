# ═══════════════════════════════════════════════════════════
# Nexus TV Frontend — Nginx default.conf con logging endurecido (AUD-006 / MISIÓN 4C)
#
# Este archivo es una REEMPLAZO COMPLETO de frontend/nginx.conf, pensado para
# validación offline (nginx -t en contenedor efímero) y para despliegue en una
# ventana controlada. NO está desplegado en el entorno activo.
#
# Objetivo: evitar que el request line del handshake Socket.IO (que puede incluir
# ?device_token=... en clientes legacy) se registre en los access logs.
#
# Nota de contexto Nginx: los archivos en /etc/nginx/conf.d/*.conf se incluyen
# dentro del bloque http{}; por eso `log_format` (contexto http) vive aquí arriba,
# fuera del bloque server{}.
# ═══════════════════════════════════════════════════════════

# Formato de log SIN query string: usa $uri (sin argumentos) en lugar de
# $request / $request_uri, que sí incluirían device_token.
# Se conservan los campos operativos habituales (ip, usuario, método, host,
# ruta, protocolo, status, bytes, referer, user-agent).
log_format nexus_safe_query '$remote_addr - $remote_user [$time_local] '
                           '"$request_method $host$uri $server_protocol" '
                           '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

server {
    listen 8080;
    listen [::]:8080;
    client_max_body_size 500M;
    client_body_timeout 300s;

    # Deshabilitar cache de assets para asegurar versiones actualizadas
    location /assets/ {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header Pragma "no-cache";
        expires -1;
    }

    # Proxy a API con soporte para subida de archivos grandes (hasta 500MB)
    location /api/ {
        proxy_pass http://backend:3002/api/;
        client_max_body_size 500M;
        proxy_read_timeout 300s;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Proxy para Socket.io (WebSockets) — access log SEGURO (sin query string)
    location /socket.io/ {
        access_log /var/log/nginx/socket_io_access.log nexus_safe_query;
        error_log  /var/log/nginx/socket_io_error.log warn;
        proxy_pass http://backend:3002/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
    }

    # Proxy para Socket.io namespace /control — access log SEGURO (sin query string)
    location /control/socket.io/ {
        access_log /var/log/nginx/control_access.log nexus_safe_query;
        error_log  /var/log/nginx/control_error.log warn;
        proxy_pass http://backend:3002/control/socket.io/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
    }

    # Proxy a Media local — TODAS las peticiones pasan por backend para validación HMAC (AUD-007 / MISIÓN 5)
    # Access log seguro sin query string (oculta la firma HMAC)
    location /media/ {
        access_log /var/log/nginx/media_access.log nexus_safe_query;
        error_log  /var/log/nginx/media_error.log warn;
        proxy_pass http://backend:3002/media/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
