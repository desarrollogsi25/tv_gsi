# ======================================================
# NEXUS TV ENTERPRISE (GSI) — ENVIRONMENT CONFIGURATION
# ======================================================

# Puertos en Host (Puertos lejanos no comunes para evitar colisiones)
# PostgreSQL is loopback-only by default; use 0.0.0.0 only for an explicitly
# approved remote admin workflow, and restrict it with host firewall rules.
HOST_DB_BIND=127.0.0.1
HOST_DB_PORT=25432
HOST_API_PORT=23002
HOST_WEB_PORT=28080

# Base de Datos PostgreSQL
PG_HOST=db
PG_PORT=5432
# Bootstrap administrator (used by PostgreSQL initialization and DB administration only).
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET

# Dedicated backend runtime login; use a different generated secret.
PG_APP_USER=nexus_app
PG_APP_PASSWORD=REPLACE_WITH_A_DIFFERENT_UNIQUE_RANDOM_SECRET
PG_DATABASE=nexus_tv

# Entorno de Node.js
NODE_ENV=production
PORT=3002
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
ALLOWED_ORIGINS=http://localhost:28080,http://127.0.0.1:28080

# Rutas de almacenamiento
MEDIA_DIR=/app/media

# Compatibilidad Socket.IO (AUD-006)
# false: rechaza device_token en query string (predeterminado seguro para producción).
# true: permite fallback temporal de compatibilidad mientras se migran clientes físicos.
ALLOW_QUERY_DEVICE_TOKEN=false

# Observación de intentos de uso del canal obsoleto (AUD-006 / Misión 4B).
# INDEPENDIENTE de ALLOW_QUERY_DEVICE_TOKEN: cuando true, el servidor registra
# (sin exponer tokens ni URIs) que un cliente envió device_token en la query
# string, aunque el fallback esté DEShabilitado. Nunca acepta la credencial por
# query por el mero hecho de estar activa. No requiere habilitar el fallback.
# false en producción hasta que se active intencionalmente una campaña de inventario.
OBSERVE_QUERY_DEVICE_TOKEN=false

# Nota de operación: para desplegar observación sin autenticación heredada,
# deje ALLOW_QUERY_DEVICE_TOKEN=false y OBSERVE_QUERY_DEVICE_TOKEN=true.
# Active el fallback (ALLOW_QUERY_DEVICE_TOKEN=true) SOLO si hay pantallas
# físicas identificadas que requieran migración y sólo con autorización.

# Firma de URLs multimedia (AUD-007 / MISIÓN 5)
# Clave secreta para HMAC-SHA256 de URLs firmadas temporales.
# DEBE ser una cadena aleatoria segura de al menos 32 bytes (64 hex chars).
# NO usar valor por defecto; generar con: openssl rand -hex 32
MEDIA_URL_SIGNING_KEY=REPLACE_WITH_A_SECURE_RANDOM_KEY_MIN_32_BYTES
